Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.05
      Class: rviz_default_plugins/Grid
      Name: Grid
      Plane: XY
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: SO-101
      Value: true
    - Class: rviz_default_plugins/TF
      Frame Timeout: 15
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.75
      Focal Point:
        X: -0.08
        Y: 0.0
        Z: 0.12
      Name: Current View
      Pitch: 0.45
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
