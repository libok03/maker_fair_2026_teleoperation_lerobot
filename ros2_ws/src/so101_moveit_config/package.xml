<?xml version="1.0"?>
<package format="3">
  <name>so101_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt 2 configuration with OMPL, Pilz, and STOMP for SO-101.</description>
  <maintainer email="maintainer@example.com">SO-101 Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>so101_bringup</exec_depend>
  <exec_depend>so101_description</exec_depend>
  <exec_depend>stomp_moveit</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
